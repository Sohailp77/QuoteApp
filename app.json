{
  "expo": {
    "name": "QuoteApp",
    "slug": "quote-native-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#0F0F1A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.yourcompany.bizflow"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F0F1A"
      },
      "package": "com.yourcompany.bizflow",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-image-picker",
      "expo-web-browser",
      "@react-native-community/datetimepicker"
    ],
    "scheme": "bizFlow",
    "extra": {
      "eas": {
        "projectId": "3b6d4f7f-ec13-4260-9eaf-633ec1618107"
      }
    }
  }
}
